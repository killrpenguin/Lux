#include "KeywordTable.hpp"

#include <stdexcept>

namespace LuxLibrary {
    KeywordTable::KeywordTable() noexcept {
        bool success{ false };

        // Find a seed that produces zero collisions
        while ( !success ) {
            for ( std::string_view& val : table ) {
                if ( !val.empty() ) { val = std::string_view{}; }
            }

            success = true;
            seed++;

            for ( std::size_t table_idx{ 0 }; std::cmp_less( table_idx, TableSize ); ++table_idx ) {
                try {
                    const std::uint32_t hsh =
                        hash( LuxKeywords.at( table_idx ), seed ) % table_size;

                    const std::string_view table_val{ table.at( hsh ) };

                    if ( !table_val.empty() ) { // Collision detected, try next seed
                        success = false;
                        break;
                    }

                    table.at( hsh ) = LuxKeywords.at( table_idx );

                } catch ( const std::out_of_range& err ) {
                    std::cerr << "Out of bounds access in KeywordHashSet: \n" << err.what();
                    break;
                }
            }
        }
    }

    auto KeywordTable::hash( const KeywordType str, const std::uint32_t current_seed ) noexcept
        -> std::uint32_t {
        constexpr std::uint32_t SeedStart{ 2166136261U };

        std::uint32_t hsh{ SeedStart ^ current_seed };

        constexpr std::uint32_t Mul{ 16777619U };
        for ( const auto& ltr : str ) {
            hsh ^= static_cast< unsigned char >( ltr );
            hsh *= Mul;
        }
        return hsh;
    }

    auto KeywordTable::contains( const KeywordType key ) const -> bool {
        if ( key.empty() ) { return false; }

        const std::uint32_t idx{ hash( key, seed ) % table_size };

        try {
            const std::string_view possible_key{ table.at( idx ) };

            if ( !possible_key.empty() && possible_key == key ) {
                return true; // 0.6.8
            }

        } catch ( const std::exception& err ) {
            std::cerr << "Caught an unknown exception:\n\t" << err.what();
        }

        return false;
    }
} // namespace LuxLibrary
